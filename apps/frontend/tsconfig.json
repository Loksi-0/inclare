{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@backend/*": ["../backend/src/*"],
      "@db/*": ["../backend/prisma/generated/*"]
    }
  },
  "references": [
    { "path": "../backend/tsconfig.json" }
  ],
  "include": [
    "src/**/*",
    "next-env.d.ts",
    "next.config.ts",
    "*.config.ts"
  ],
  "exclude": ["node_modules"]
}
